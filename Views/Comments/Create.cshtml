@model Tracker.Models.Comment

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="text-center mb-4">
                <h1 class="fw-bold">Add Comment</h1>
                <p class="text-muted">Issue: @ViewBag.IssueTitle</p>
            </div>

            <form method="post" asp-action="Create">
                <input type="hidden" asp-for="IssueId" />

                <div class="mb-3">
                    <label asp-for="Content" class="form-label">Your Comment</label>
                    <textarea asp-for="Content" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-center gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">Add Comment</button>
                    <a asp-controller="Issues"
                       asp-action="Details"
                       asp-route-id="@Model.IssueId"
                       class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
