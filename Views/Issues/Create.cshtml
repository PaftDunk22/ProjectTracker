@model Tracker.Models.Issue

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="text-center mb-4">
                <h1 class="fw-bold">Create Issue</h1>
                <p class="text-muted">For project: @ViewBag.ProjectName</p>
            </div>

            <form method="post" asp-action="Create">
                <input type="hidden" asp-for="ProjectId" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Issue Title</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Priority" class="form-label"></label>
                    <select asp-for="Priority"
                            asp-items="Html.GetEnumSelectList<Priority>()"
                            class="form-select">
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="Status" class="form-label"></label>
                    <select asp-for="Status"
                            asp-items="Html.GetEnumSelectList<Status>()"
                            class="form-select">
                    </select>
                </div>

                <div class="d-flex justify-content-center gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">Create Issue</button>
                    <a asp-controller="Projects"
                       asp-action="Details"
                       asp-route-id="@Model.ProjectId"
                       class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
