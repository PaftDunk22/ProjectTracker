@model Tracker.Models.Issue

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="text-center mb-4">
                <h1 class="fw-bold">Delete Issue</h1>
                <p class="text-muted">Are you sure you want to delete this issue?</p>
            </div>

            <div class="alert alert-warning text-center">
                <strong>Warning!</strong> This action is permanent and cannot be undone.
                All comments belonging to this issue will also be deleted.
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="card-title">@Model.Title</h5>
                    <p class="card-text text-muted">
                        @(string.IsNullOrWhiteSpace(Model.Description) ? "No description." : Model.Description)
                    </p>

                    <div class="d-flex justify-content-between">
                        <span class="badge bg-secondary">@Model.Status</span>
                        <span class="badge bg-secondary">@Model.Priority</span>
                    </div>

                    <hr />

                    <small class="text-muted">
                        Created: @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                    </small>
                </div>
            </div>

            <form method="post" asp-action="DeleteConfirmation">
                <input type="hidden" asp-for="Id" />

                <div class="d-flex justify-content-center gap-2">
                    <button type="submit" class="btn btn-danger"> Confirm Deletion </button>

                    <a asp-controller="Issues" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary"> Cancel </a>
                </div>
            </form>

        </div>
    </div>
</div>
