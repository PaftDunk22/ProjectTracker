@model Tracker.Models.Project

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="text-center mb-4">
                <h1 class="fw-bold">@Model.Name</h1>

                <p class="text-muted mb-2">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
                </p>

                <small class="text-muted">
                    Created: @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                </small>
            </div>

            <hr />

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="mb-0">Issues</h3>
                <span class="badge bg-primary rounded-pill">
                    @Model.Issues.Count
                </span>
            </div>

            @if (!Model.Issues.Any())
            {
                <p class="text-muted text-center">
                    No issues for this project yet.
                </p>
            }
            else
            {
                @foreach (var issue in Model.Issues)
                {
                    <div>
                        <a asp-controller="Issues" asp-action="Details" asp-route-id="@issue.Id" class="text-decoration-none text-dark">
                        <div class="card clickable-card shadow-sm mb-3">
                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h5 class="mb-0">
                                        @issue.Title
                                    </h5>

                                    <span class="badge bg-secondary">
                                        @issue.Comments.Count comments
                                    </span>
                                </div>


                                <p class="text-muted mb-3">
                                    @(string.IsNullOrWhiteSpace(issue.Description) ? "No description." : issue.Description)
                                </p>

                                <div class="d-flex justify-content-between flex-wrap">
                                    <span class="badge bg-secondary">
                                        @issue.Status
                                    </span>

                                    <span class="badge bg-secondary">
                                        @issue.Priority Priority
                                    </span>

                                    <small class="text-muted">
                                        @issue.CreatedAt.ToString("dd.MM.yyyy")
                                    </small>
                                </div>

                            </div>
                        </div>
                        </a>
                   </div>
                }
            }

            <div class="d-flex justify-content-center flex-wrap gap-2 mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"> Edit Project </a>

                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger"> Delete Project </a>

                <a asp-controller="Issues" asp-action="Create" asp-route-projectId="@Model.Id" class="btn btn-primary"> Add Issue </a>
            </div>
        </div>
    </div>
</div>
